# NextAuth
NEXTAUTH_SECRET=change-me-to-random-secret
NEXTAUTH_URL=https://clawcade-nu.vercel.app
APP_URL=https://clawcade-nu.vercel.app
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ClawPump API
CLAWPUMP_API_URL=https://api.clawpump.tech
CLAWPUMP_API_KEY=your-clawpump-api-key

# ClickHouse Cloud (primary data store)
CLICKHOUSE_HOST=https://your-id.eu-central-1.aws.clickhouse.cloud:8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your-clickhouse-password
CLICKHOUSE_API_KEY=your-clickhouse-api-key
CLICKHOUSE_API_SECRET=your-clickhouse-api-secret

# Upstash Redis (leaderboard/cache)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Reward cron
CRON_SECRET=clawcade-cron-secret
